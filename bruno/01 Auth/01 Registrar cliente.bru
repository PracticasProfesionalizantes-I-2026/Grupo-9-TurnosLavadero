meta {
  name: Registrar cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Juan",
    "apellido": "Prueba",
    "email": "juan.prueba@example.test",
    "password": "ClaveSegura123",
    "telefono": "+54 3493 123456"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("token", res.body.token);
    bru.setEnvVar("clienteId", res.body.clienteId);
  }
}
