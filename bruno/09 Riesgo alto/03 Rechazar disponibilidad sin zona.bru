}

get {
  url: {{baseUrl}}/api/turnos/disponibilidad?servicioId={{servicioId}}&fechaHora=2099-01-10T12:00:00
  body: none
  auth: bearer
}

auth:bearer {
  token: {{clienteToken}}
}

tests {
