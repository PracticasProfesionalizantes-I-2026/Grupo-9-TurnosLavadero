meta {
  name: Rechazar inicio 30 minutos despues
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clienteToken}}
}

body:json {
  {"servicioId":"{{servicioId}}","fechaHora":"{{intervaloMedio}}"}
}

tests {
