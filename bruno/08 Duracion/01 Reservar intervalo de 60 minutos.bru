meta {
  name: Reservar intervalo de 60 minutos
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clienteToken}}
}

body:json {
  {"servicioId":"{{servicioId}}","fechaHora":"{{intervaloInicio}}"}
}

script:pre-request {
  const inicio = new Date(Date.now() + 20 * 86400000);
  bru.setEnvVar("intervaloInicio", inicio.toISOString());
  bru.setEnvVar("intervaloMedio", new Date(inicio.getTime()+30*60000).toISOString());
  bru.setEnvVar("intervaloFin", new Date(inicio.getTime()+60*60000).toISOString());
}

script:post-response {
  if (res.status===201) bru.setEnvVar("intervaloId", res.body.id);
}

tests {
  test("HTTP 201", function () { expect(res.status).to.equal(201); expect(res.body.duracionMinutos).to.equal(60); });
}
