meta {
  name: Registrar cliente CU07
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/registro
  body: json
  auth: none
}

body:json {
  {"nombre":"Cliente","apellido":"Demo","email":"{{demoEmail}}","password":"{{demoPassword}}"}
}


script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("clienteId", res.body.clienteId);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.status).to.equal(201);
  });
}
